# Application
APP_NAME=aegis
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=local-development-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# LLM Provider (openai, gemini, mock)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
LOCAL_MODEL_URL=http://localhost:11434

# AI Safety
MAX_AGENT_ITERATIONS=15
MAX_TOKEN_BUDGET=50000
MAX_TOOL_CALLS=20
MAX_INVESTIGATION_SECONDS=300

# Auth
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Required to create the initial admin user. Use a unique secret in each environment.
DEFAULT_ADMIN_PASSWORD=change-me-before-startup

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Frontend
FRONTEND_URL=http://localhost:3000
